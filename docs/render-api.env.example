# Public settings. Put real secret values ONLY in Render's protected environment.
BRIIFF_ENV=production
FIREBASE_PROJECT_ID=briif-site
BRIIFF_ALLOWED_ORIGINS=https://briif-site.onrender.com
GEMINI_MODEL=gemini-3.1-flash-lite
